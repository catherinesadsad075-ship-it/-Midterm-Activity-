#include <iostream>
#include <string>
using namespace std;

int main() {
    //--Declaring variables of different data types--
    int age = 29;
	double price = 19.99; //decimal number (double precision)
	float weight = 65.5f; //decimal number (single precision, using the 'f')
	char grade = 'A'; //single quotes for single character
	bool isStudent = true; //True or False
	string name = "Maria"; //text
   //---Output using cout---
	cout << "Name: "<<name << endl;
	cout << "Age: "<<age << endl;
	cout << "Price: "<<price << endl;
	cout << "Weight: "<<weight << endl;
	cout << "Grade: "<<grade << endl;
	cout << "Is student? "<<isStudent << endl;
}

#include <iostream>
#include <string>
using namespace std;

int main() {
    string userCity;
    cout << "\nEnter your City: ";
    cin >> userCity; // reads one word (stops at whitespace)
    cout << "You live in: "<< userCity << endl;
    
    //---Reading a full line (including spaces)
    cin.ignore(); // clear leftover newline character from previuos cin
    string fullSentece;
    getline(cin, fullSentece); //read the entire line
    cout << "You said: " << fullSentece << endl;
    return 0;
}

